# Firestore rules (firebase.rules)

// Firestore rules (example - adapt before use)
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /pages/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{doc} {
      allow read: if isAdmin();
      // Creating admin documents should be restricted — create via console or an existing admin
      allow write: if isAdmin();
    }
  }
}

// Storage rules (firebase.storage.rules)
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if true; // public read for now
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
